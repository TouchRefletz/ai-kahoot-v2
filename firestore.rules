rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isHost(gameId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/games/$(gameId)).data.hostUid == request.auth.uid;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidGame() {
      return hasRequiredFields(['hostUid', 'status', 'currentQuestionIndex', 'createdAt']) &&
             request.resource.data.hostUid is string &&
             request.resource.data.status in ['lobby', 'question', 'answer_reveal', 'leaderboard', 'podium', 'generating', 'ended'] &&
             request.resource.data.currentQuestionIndex is number;
    }
    
    function isValidQuestion() {
      return request.resource.data.keys().hasAll(['index', 'prompt']) &&
             request.resource.data.index is number &&
             request.resource.data.prompt is string &&
             request.resource.data.prompt.size() > 0 &&
             request.resource.data.prompt.size() <= 4000;
    }
    
    function isValidPlayer() {
      return hasRequiredFields(['uid', 'name', 'score', 'joinedAt']) &&
             request.resource.data.uid is string &&
             request.resource.data.name is string &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.name.size() <= 100 &&
             request.resource.data.score is number;
    }

    // Health check collection for connection test
    match /test/{docId} {
      allow read: if true;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    match /games/{gameId} {
      // Anyone can read a game to join it or play
      allow read: if true;
      // Only authenticated users can create a game, and they must be the host
      allow create: if isAuthenticated() && isValidGame() && request.resource.data.hostUid == request.auth.uid;
      // Only the host can update the game state
      allow update: if isAuthenticated() && isValidGame() && resource.data.hostUid == request.auth.uid && request.resource.data.hostUid == resource.data.hostUid;
      // Only the host can delete the game
      allow delete: if isAuthenticated() && resource.data.hostUid == request.auth.uid;
      
      match /questions/{questionId} {
        // Anyone in the game can read questions
        allow read: if true;
        // Host can add, update, and delete questions
        allow create: if isHost(gameId) && isValidQuestion();
        allow update: if isHost(gameId) && isValidQuestion();
        allow delete: if isHost(gameId);
      }
      
      match /players/{playerId} {
        // Anyone can read players (for leaderboard and lobby list)
        allow read: if true;
        // Authenticated users can join as a player
        allow create: if isAuthenticated() && isValidPlayer() && request.resource.data.uid == request.auth.uid;
        // Players can update their own score/answers, host can also update players (e.g. score adjustments, notes)
        allow update: if isAuthenticated() && isValidPlayer() && (
          resource.data.uid == request.auth.uid || isHost(gameId)
        ) && request.resource.data.uid == resource.data.uid;
        // Players can leave/remove themselves, or the host can remove/kick any player
        allow delete: if isAuthenticated() && (
          resource.data.uid == request.auth.uid || isHost(gameId)
        );
      }
    }
  }
}

